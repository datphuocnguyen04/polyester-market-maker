{
  "name": "polyester-mm-bot",
  "version": "1.0.0",
  "description": "Polyester DEX Testnet auto-swap (top 5 trending pairs) and daily reward claim bot",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "dry": "tsx src/index.ts --dry-run --once",
    "claim": "tsx src/index.ts --claim-only --once",
    "swap": "tsx src/index.ts --swap-only --once",
    "trending": "tsx src/index.ts --trending-only --once",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.8.1",
    "@polyester/sdk": "^0.34.0",
    "dotenv": "^16.4.7",
    "viem": "2.55.10"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
